Options All -Indexes

RewriteEngine On

RewriteRule ^([-a-zA-Z0-9]+)$ index.php?route=$1
RewriteRule ^([-a-zA-Z0-9]+)__([-a-zA-Z0-9]+)$ index.php?route=$1&docno=$2


RewriteEngine On

RewriteRule ^([-a-zA-Z0-9]+)$ index.php?id=$1
RewriteRule  ^([-a-zA-Z0-9]+)__([-a-zA-Z0-9]+)$ /index/$1/ [R]